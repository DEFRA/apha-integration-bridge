INVOLVEMENT AS (
  SELECT
    TF.FEATURE_PK,
    TF.LOCATION_ID,
    FI.FEATURE_INVOLVEMENT_PK AS INVOLVEMENT_PK,
    FI.FEATURE_INVOLVEMENT_TYPE AS INVOLVEMENT_TYPE,
    FI.FEATURE_INVOLV_FROM_DATE AS INVOLVEMENT_FROM_DATE,
    CAST(NULL AS VARCHAR2(20)) AS INVOLVEMENT_STATUS,
    CAST(NULL AS DATE) AS LAST_CHECKED_DATE,
    CAST(NULL AS VARCHAR2(8)) AS LIVESTOCK_UNIT_ID,
    FI.CPH,
    FI.VETNET_CORE_ID,
    FI.PARTY_ROLE_PK
  FROM TARGET_FEATURE TF
  JOIN AHBRP.FEATURE_INVOLVEMENT FI
    ON FI.FEATURE_PK = TF.FEATURE_PK
   AND FI.FEATURE_INVOLVEMENT_TYPE = 'CPHHOLDERSHIP'
   AND FI.FEATURE_INVOLV_TO_DATE IS NULL

  UNION ALL

  SELECT
    TF.FEATURE_PK,
    TF.LOCATION_ID,
    FI.FEATURE_INVOLVEMENT_PK,
    FI.FEATURE_INVOLVEMENT_TYPE,
    FI.FEATURE_INVOLV_FROM_DATE,
    FI.OWNER_OF_PLACE_STATUS,
    FI.OWNERSHIP_LAST_CHECKED_DATE,
    CAST(NULL AS VARCHAR2(8)),
    CAST(NULL AS VARCHAR2(11)),
    CAST(NULL AS NUMBER),
    FI.PARTY_ROLE_PK
  FROM TARGET_FEATURE TF
  JOIN AHBRP.FEATURE_INVOLVEMENT FI
    ON FI.FEATURE_PK = TF.FEATURE_PK
   AND FI.FEATURE_INVOLVEMENT_TYPE = 'OWNEROFLOCATION'
   AND FI.FEATURE_INVOLV_FROM_DATE <= SYSDATE
   AND (FI.FEATURE_INVOLV_TO_DATE IS NULL OR FI.FEATURE_INVOLV_TO_DATE > SYSDATE)

  UNION ALL

  SELECT
    TF.FEATURE_PK,
    TF.LOCATION_ID,
    AI.ASSET_INVOLVEMENT_PK,
    AI.ASSET_INVOLVEMENT_TYPE,
    AI.ASSET_INVOLVEMENT_FROM_DATE,
    CASE WHEN AI.ASSET_INVOLVEMENT_TYPE = 'OWNEROF' THEN AI.OWNERSHIP_STATUS ELSE AI.KEEPERSHIP_STATUS END,
    CAST(NULL AS DATE),
    LU.UNIT_ID,
    CAST(NULL AS VARCHAR2(11)),
    CAST(NULL AS NUMBER),
    AI.PARTY_ROLE_PK
  FROM TARGET_FEATURE TF
  JOIN AHBRP.ASSET_LOCATION AL
    ON AL.FEATURE_PK = TF.FEATURE_PK
   AND AL.ASSET_LOCATION_TYPE = 'PRIMARYLOCATION'
   AND AL.ASSET_LOCATION_FROM_DATE <= SYSDATE
   AND (AL.ASSET_LOCATION_TO_DATE IS NULL OR AL.ASSET_LOCATION_TO_DATE > SYSDATE)
  JOIN AHBRP.LIVESTOCK_UNIT LU
    ON LU.ASSET_PK = AL.ASSET_PK
  JOIN AHBRP.ASSET_INVOLVEMENT AI
    ON AI.ASSET_PK = AL.ASSET_PK
   AND AI.ASSET_INVOLVEMENT_TYPE IN ('PRIMARYKEEPEROF', 'SECONDARYKEEPEROF', 'OWNEROF')
   AND AI.ASSET_INVOLVEMENT_FROM_DATE <= SYSDATE
   AND (AI.ASSET_INVOLVEMENT_TO_DATE IS NULL OR AI.ASSET_INVOLVEMENT_TO_DATE > SYSDATE)
)
SELECT
  I.FEATURE_PK,
  I.LOCATION_ID,
  I.INVOLVEMENT_PK,
  I.INVOLVEMENT_TYPE,
  I.INVOLVEMENT_FROM_DATE,
  I.INVOLVEMENT_STATUS,
  I.LAST_CHECKED_DATE,
  I.LIVESTOCK_UNIT_ID,
  I.CPH,
  I.VETNET_CORE_ID,
  P.PARTY_PK,
  P.PARTY_ID,
  PV.PARTY_TYPE,
  PS.PARTY_STATUS_CODE,
  PR.PARTY_ROLE_PK,
  PR.MAIN_ROLE_TYPE,
  R.ROLE_TYPE,
  PR.PARTY_ROLE_FROM_DATE
FROM INVOLVEMENT I
JOIN AHBRP.PARTY_ROLE PR
  ON PR.PARTY_ROLE_PK = I.PARTY_ROLE_PK
JOIN AHBRP.ROLE R
  ON R.ROLE_PK = PR.ROLE_PK
JOIN AHBRP.PARTY P
  ON P.PARTY_PK = PR.PARTY_PK
LEFT JOIN AHBRP.PARTY_VERSION PV
  ON PV.PARTY_PK = P.PARTY_PK
 AND PV.PARTY_VERSION_TO_DATETIME = '31-DEC-9999'
LEFT JOIN AHBRP.PARTY_STATE PS
  ON PS.PARTY_PK = P.PARTY_PK
 AND PS.PARTY_STATE_TO_DTTM IS NULL
WHERE (
    I.INVOLVEMENT_TYPE = 'CPHHOLDERSHIP'
    AND PR.PARTY_ROLE_TO_DATE IS NULL
    AND PS.PARTY_STATUS_CODE <> 'INACTIVE'
  ) OR (
    I.INVOLVEMENT_TYPE <> 'CPHHOLDERSHIP'
    AND PR.PARTY_ROLE_FROM_DATE <= SYSDATE
    AND (PR.PARTY_ROLE_TO_DATE IS NULL OR PR.PARTY_ROLE_TO_DATE > SYSDATE)
  )
ORDER BY I.FEATURE_PK, P.PARTY_ID, I.INVOLVEMENT_TYPE, I.INVOLVEMENT_PK
"
