// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`returns the expected query for multiple party keys 1`] = `
"WITH
ROLE_NAME AS (
  SELECT
    RDC.CODE,
    MAX(RDCD.SHORT_DESCRIPTION) KEEP (DENSE_RANK LAST ORDER BY RDC.EFFECTIVE_TO_DATE) AS SHORT_DESCRIPTION
  FROM AHBRP.REF_DATA_SET RDS
  JOIN AHBRP.REF_DATA_CODE RDC
    ON RDC.REF_DATA_SET_PK = RDS.REF_DATA_SET_PK
  JOIN AHBRP.REF_DATA_CODE_DESC RDCD
    ON RDCD.REF_DATA_CODE_PK = RDC.REF_DATA_CODE_PK
   AND RDCD.LANGUAGE_CODE = 'ENG'
  WHERE RDS.REF_DATA_SET_NAME = 'ROLE_TYPE'
  GROUP BY RDC.CODE
)
SELECT
  PR.PARTY_PK,
  PR.PARTY_ROLE_PK,
  PR.MAIN_ROLE_TYPE,
  R.ROLE_TYPE,
  RN.SHORT_DESCRIPTION AS ROLE_NAME,
  PR.PARTY_ROLE_FROM_DATE
FROM AHBRP.PARTY_ROLE PR
JOIN AHBRP.ROLE R
  ON R.ROLE_PK = PR.ROLE_PK
LEFT JOIN ROLE_NAME RN
  ON RN.CODE = R.ROLE_TYPE
WHERE PR.PARTY_PK IN (:id0, :id1)
  AND PR.PARTY_ROLE_FROM_DATE <= SYSDATE
  AND (PR.PARTY_ROLE_TO_DATE IS NULL OR PR.PARTY_ROLE_TO_DATE > SYSDATE)
ORDER BY PR.PARTY_PK, PR.PARTY_ROLE_FROM_DATE, PR.PARTY_ROLE_PK
"
`;

exports[`returns the expected query for valid parameters 1`] = `
"WITH
ROLE_NAME AS (
  SELECT
    RDC.CODE,
    MAX(RDCD.SHORT_DESCRIPTION) KEEP (DENSE_RANK LAST ORDER BY RDC.EFFECTIVE_TO_DATE) AS SHORT_DESCRIPTION
  FROM AHBRP.REF_DATA_SET RDS
  JOIN AHBRP.REF_DATA_CODE RDC
    ON RDC.REF_DATA_SET_PK = RDS.REF_DATA_SET_PK
  JOIN AHBRP.REF_DATA_CODE_DESC RDCD
    ON RDCD.REF_DATA_CODE_PK = RDC.REF_DATA_CODE_PK
   AND RDCD.LANGUAGE_CODE = 'ENG'
  WHERE RDS.REF_DATA_SET_NAME = 'ROLE_TYPE'
  GROUP BY RDC.CODE
)
SELECT
  PR.PARTY_PK,
  PR.PARTY_ROLE_PK,
  PR.MAIN_ROLE_TYPE,
  R.ROLE_TYPE,
  RN.SHORT_DESCRIPTION AS ROLE_NAME,
  PR.PARTY_ROLE_FROM_DATE
FROM AHBRP.PARTY_ROLE PR
JOIN AHBRP.ROLE R
  ON R.ROLE_PK = PR.ROLE_PK
LEFT JOIN ROLE_NAME RN
  ON RN.CODE = R.ROLE_TYPE
WHERE PR.PARTY_PK IN (:id0)
  AND PR.PARTY_ROLE_FROM_DATE <= SYSDATE
  AND (PR.PARTY_ROLE_TO_DATE IS NULL OR PR.PARTY_ROLE_TO_DATE > SYSDATE)
ORDER BY PR.PARTY_PK, PR.PARTY_ROLE_FROM_DATE, PR.PARTY_ROLE_PK
"
`;
