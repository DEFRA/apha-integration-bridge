// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`returns the expected query for multiple feature keys 1`] = `
"WITH
TARGET_SUB_LOCATION AS (
  SELECT
    FR.FIRST_FEATURE_PK AS PREMISES_FEATURE_PK,
    SL.FEATURE_PK,
    SL.SUB_LOCATION_TYPE,
    SL.USABLE_AREA,
    SL.USUAL_STOCK_QUANTITY,
    SL.BROILER_STOCKG_DENSITY_RANGE,
    FR.FEATURE_RELATN_FROM_DATE
  FROM AHBRP.FEATURE_RELATIONSHIP FR
  JOIN AHBRP.SUB_LOCATION SL
    ON SL.FEATURE_PK = FR.SECOND_FEATURE_PK
  WHERE FR.FIRST_FEATURE_PK IN (:id0, :id1)
    AND FR.FEATURE_RELATIONSHIP_TYPE = 'CONTAINS'
    AND FR.FEATURE_RELATN_TO_DATE IS NULL
),
-- the current primary point: the latest, then the highest SAM key, as
-- find-locations.sql ranks a location's
CURRENT_FEATURE_POINT AS (
  SELECT
    FP.FEATURE_PK,
    FP.FEATURE_POINT_TYPE,
    FP.OS_MAP_REFERENCE,
    FP.EASTING,
    FP.NORTHING,
    ROW_NUMBER() OVER (
      PARTITION BY FP.FEATURE_PK
      ORDER BY FP.FEATURE_POINT_FROM_DATE DESC, FP.FEATURE_POINT_PK DESC
    ) POINT_RANK
  FROM TARGET_SUB_LOCATION SL
  JOIN AHBRP.FEATURE_POINT FP
    ON FP.FEATURE_PK = SL.FEATURE_PK
   AND FP.PRIMARY_FEATURE_POINT_IND = 'Y'
   AND FP.FEATURE_POINT_TO_DATE IS NULL
),
-- the sub-location's own current address: postal first, then the latest
-- start date, then the highest SAM key, as find-locations.sql ranks a
-- location's
CURRENT_FEATURE_ADDRESS AS (
  SELECT
    FA.FEATURE_PK,
    FA.ADDRESS_PK,
    FA.FEATURE_ADDRESS_PK,
    FA.FEATURE_ADDRESS_FROM_DATE,
    ROW_NUMBER() OVER (
      PARTITION BY FA.FEATURE_PK
      ORDER BY
        CASE WHEN A.NON_POSTAL_ADDRESS_IND = 'N' THEN 0 ELSE 1 END,
        FA.FEATURE_ADDRESS_FROM_DATE DESC,
        FA.FEATURE_ADDRESS_PK DESC
    ) ADDRESS_RANK
  FROM TARGET_SUB_LOCATION SL
  JOIN AHBRP.FEATURE_ADDRESS FA
    ON FA.FEATURE_PK = SL.FEATURE_PK
   AND FA.FEATURE_ADDRESS_TO_DATE IS NULL
  LEFT JOIN AHBRP.ADDRESS A
    ON A.ADDRESS_PK = FA.ADDRESS_PK
),
-- SAM does not enforce one current state per feature: the one that is not
-- INACTIVE, the latest, then the highest SAM key, as find-locations.sql
-- ranks a location's
CURRENT_FEATURE_STATE AS (
  SELECT
    FS.FEATURE_PK,
    FS.FEATURE_STATUS_CODE,
    FS.FEATURE_STATE_REASON_CODE,
    FS.FEATURE_STATE_FROM_DTTM,
    ROW_NUMBER() OVER (
      PARTITION BY FS.FEATURE_PK
      ORDER BY FS.FEATURE_STATE_FROM_DTTM DESC NULLS LAST, FS.FEATURE_STATE_PK DESC NULLS LAST
    ) STATE_RANK
  FROM TARGET_SUB_LOCATION SL
  JOIN AHBRP.FEATURE_STATE FS
    ON FS.FEATURE_PK = SL.FEATURE_PK
   AND FS.FEATURE_STATUS_CODE <> 'INACTIVE'
   AND FS.FEATURE_STATE_TO_DTTM IS NULL
),
COUNTY_LOOKUP AS (
  SELECT DISTINCT
    RDC.CODE,
    RDCD.SHORT_DESCRIPTION
  FROM AHBRP.REF_DATA_SET RDS
  JOIN AHBRP.REF_DATA_CODE RDC
    ON RDC.REF_DATA_SET_PK = RDS.REF_DATA_SET_PK
  JOIN AHBRP.REF_DATA_CODE_DESC RDCD
    ON RDCD.REF_DATA_CODE_PK = RDC.REF_DATA_CODE_PK
  WHERE RDS.REF_DATA_SET_NAME = 'COUNTY'
    AND RDS.EFFECTIVE_TO_DATE IS NULL
    AND RDC.EFFECTIVE_TO_DATE = '31-DEC-9999'
    AND RDCD.LANGUAGE_CODE = 'ENG'
)

SELECT
  SL.PREMISES_FEATURE_PK,
  SL.FEATURE_PK,
  F.FEATURE_NAME,
  SL.SUB_LOCATION_TYPE,
  SL.USABLE_AREA,
  SL.USUAL_STOCK_QUANTITY,
  SL.BROILER_STOCKG_DENSITY_RANGE,
  SL.FEATURE_RELATN_FROM_DATE,
  FS.FEATURE_STATUS_CODE,
  FS.FEATURE_STATE_REASON_CODE,
  FS.FEATURE_STATE_FROM_DTTM,
  TRIM(FP.OS_MAP_REFERENCE) os_map_reference,
  FP.FEATURE_POINT_TYPE feature_point_type,
  CASE WHEN FP.EASTING = 0 OR FP.NORTHING = 0 THEN NULL ELSE FP.EASTING END easting,
  CASE WHEN FP.EASTING = 0 OR FP.NORTHING = 0 THEN NULL ELSE FP.NORTHING END northing,
  FA.FEATURE_ADDRESS_PK feature_address_pk,
  FA.FEATURE_ADDRESS_FROM_DATE feature_address_from_date,
  BA.PAON_START_NUMBER paon_start_number,
  BA.PAON_START_NUMBER_SUFFIX paon_start_number_suffix,
  BA.PAON_END_NUMBER paon_end_number,
  BA.PAON_END_NUMBER_SUFFIX paon_end_number_suffix,
  BA.PAON_DESCRIPTION paon_description,
  BA.SAON_DESCRIPTION saon_description,
  BA.SAON_START_NUMBER saon_start_number,
  BA.SAON_START_NUMBER_SUFFIX saon_start_number_suffix,
  BA.SAON_END_NUMBER saon_end_number,
  BA.SAON_END_NUMBER_SUFFIX saon_end_number_suffix,
  BA.STREET,
  BA.LOCALITY,
  BA.TOWN,
  COUNTY_LOOKUP.SHORT_DESCRIPTION county,
  BA.POSTCODE,
  BA.UK_INTERNAL_CODE uk_internal_code,
  BA.COUNTRY_CODE country_code
FROM TARGET_SUB_LOCATION SL
LEFT JOIN AHBRP.FEATURE F
  ON F.FEATURE_PK = SL.FEATURE_PK
LEFT JOIN CURRENT_FEATURE_STATE FS
  ON FS.FEATURE_PK = SL.FEATURE_PK
 AND FS.STATE_RANK = 1
LEFT JOIN CURRENT_FEATURE_POINT FP
  ON FP.FEATURE_PK = SL.FEATURE_PK
 AND FP.POINT_RANK = 1
LEFT JOIN CURRENT_FEATURE_ADDRESS FA
  ON FA.FEATURE_PK = SL.FEATURE_PK
 AND FA.ADDRESS_RANK = 1
LEFT JOIN AHBRP.BS7666_ADDRESS BA
  ON BA.ADDRESS_PK = FA.ADDRESS_PK
LEFT JOIN COUNTY_LOOKUP
  ON COUNTY_LOOKUP.CODE = BA.ADMINISTRATIVE_AREA
-- INACTIVE features are not returned: leave out a sub-location whose current
-- states are all INACTIVE. One with no current state at all keeps a null
-- status, as before.
WHERE FS.FEATURE_PK IS NOT NULL
   OR NOT EXISTS (
     SELECT 1
     FROM AHBRP.FEATURE_STATE ANY_FS
     WHERE ANY_FS.FEATURE_PK = SL.FEATURE_PK
       AND ANY_FS.FEATURE_STATE_TO_DTTM IS NULL
   )
ORDER BY SL.PREMISES_FEATURE_PK, SL.FEATURE_PK
"
`;

exports[`returns the expected query for valid parameters 1`] = `
"WITH
TARGET_SUB_LOCATION AS (
  SELECT
    FR.FIRST_FEATURE_PK AS PREMISES_FEATURE_PK,
    SL.FEATURE_PK,
    SL.SUB_LOCATION_TYPE,
    SL.USABLE_AREA,
    SL.USUAL_STOCK_QUANTITY,
    SL.BROILER_STOCKG_DENSITY_RANGE,
    FR.FEATURE_RELATN_FROM_DATE
  FROM AHBRP.FEATURE_RELATIONSHIP FR
  JOIN AHBRP.SUB_LOCATION SL
    ON SL.FEATURE_PK = FR.SECOND_FEATURE_PK
  WHERE FR.FIRST_FEATURE_PK IN (:id0)
    AND FR.FEATURE_RELATIONSHIP_TYPE = 'CONTAINS'
    AND FR.FEATURE_RELATN_TO_DATE IS NULL
),
-- the current primary point: the latest, then the highest SAM key, as
-- find-locations.sql ranks a location's
CURRENT_FEATURE_POINT AS (
  SELECT
    FP.FEATURE_PK,
    FP.FEATURE_POINT_TYPE,
    FP.OS_MAP_REFERENCE,
    FP.EASTING,
    FP.NORTHING,
    ROW_NUMBER() OVER (
      PARTITION BY FP.FEATURE_PK
      ORDER BY FP.FEATURE_POINT_FROM_DATE DESC, FP.FEATURE_POINT_PK DESC
    ) POINT_RANK
  FROM TARGET_SUB_LOCATION SL
  JOIN AHBRP.FEATURE_POINT FP
    ON FP.FEATURE_PK = SL.FEATURE_PK
   AND FP.PRIMARY_FEATURE_POINT_IND = 'Y'
   AND FP.FEATURE_POINT_TO_DATE IS NULL
),
-- the sub-location's own current address: postal first, then the latest
-- start date, then the highest SAM key, as find-locations.sql ranks a
-- location's
CURRENT_FEATURE_ADDRESS AS (
  SELECT
    FA.FEATURE_PK,
    FA.ADDRESS_PK,
    FA.FEATURE_ADDRESS_PK,
    FA.FEATURE_ADDRESS_FROM_DATE,
    ROW_NUMBER() OVER (
      PARTITION BY FA.FEATURE_PK
      ORDER BY
        CASE WHEN A.NON_POSTAL_ADDRESS_IND = 'N' THEN 0 ELSE 1 END,
        FA.FEATURE_ADDRESS_FROM_DATE DESC,
        FA.FEATURE_ADDRESS_PK DESC
    ) ADDRESS_RANK
  FROM TARGET_SUB_LOCATION SL
  JOIN AHBRP.FEATURE_ADDRESS FA
    ON FA.FEATURE_PK = SL.FEATURE_PK
   AND FA.FEATURE_ADDRESS_TO_DATE IS NULL
  LEFT JOIN AHBRP.ADDRESS A
    ON A.ADDRESS_PK = FA.ADDRESS_PK
),
-- SAM does not enforce one current state per feature: the one that is not
-- INACTIVE, the latest, then the highest SAM key, as find-locations.sql
-- ranks a location's
CURRENT_FEATURE_STATE AS (
  SELECT
    FS.FEATURE_PK,
    FS.FEATURE_STATUS_CODE,
    FS.FEATURE_STATE_REASON_CODE,
    FS.FEATURE_STATE_FROM_DTTM,
    ROW_NUMBER() OVER (
      PARTITION BY FS.FEATURE_PK
      ORDER BY FS.FEATURE_STATE_FROM_DTTM DESC NULLS LAST, FS.FEATURE_STATE_PK DESC NULLS LAST
    ) STATE_RANK
  FROM TARGET_SUB_LOCATION SL
  JOIN AHBRP.FEATURE_STATE FS
    ON FS.FEATURE_PK = SL.FEATURE_PK
   AND FS.FEATURE_STATUS_CODE <> 'INACTIVE'
   AND FS.FEATURE_STATE_TO_DTTM IS NULL
),
COUNTY_LOOKUP AS (
  SELECT DISTINCT
    RDC.CODE,
    RDCD.SHORT_DESCRIPTION
  FROM AHBRP.REF_DATA_SET RDS
  JOIN AHBRP.REF_DATA_CODE RDC
    ON RDC.REF_DATA_SET_PK = RDS.REF_DATA_SET_PK
  JOIN AHBRP.REF_DATA_CODE_DESC RDCD
    ON RDCD.REF_DATA_CODE_PK = RDC.REF_DATA_CODE_PK
  WHERE RDS.REF_DATA_SET_NAME = 'COUNTY'
    AND RDS.EFFECTIVE_TO_DATE IS NULL
    AND RDC.EFFECTIVE_TO_DATE = '31-DEC-9999'
    AND RDCD.LANGUAGE_CODE = 'ENG'
)

SELECT
  SL.PREMISES_FEATURE_PK,
  SL.FEATURE_PK,
  F.FEATURE_NAME,
  SL.SUB_LOCATION_TYPE,
  SL.USABLE_AREA,
  SL.USUAL_STOCK_QUANTITY,
  SL.BROILER_STOCKG_DENSITY_RANGE,
  SL.FEATURE_RELATN_FROM_DATE,
  FS.FEATURE_STATUS_CODE,
  FS.FEATURE_STATE_REASON_CODE,
  FS.FEATURE_STATE_FROM_DTTM,
  TRIM(FP.OS_MAP_REFERENCE) os_map_reference,
  FP.FEATURE_POINT_TYPE feature_point_type,
  CASE WHEN FP.EASTING = 0 OR FP.NORTHING = 0 THEN NULL ELSE FP.EASTING END easting,
  CASE WHEN FP.EASTING = 0 OR FP.NORTHING = 0 THEN NULL ELSE FP.NORTHING END northing,
  FA.FEATURE_ADDRESS_PK feature_address_pk,
  FA.FEATURE_ADDRESS_FROM_DATE feature_address_from_date,
  BA.PAON_START_NUMBER paon_start_number,
  BA.PAON_START_NUMBER_SUFFIX paon_start_number_suffix,
  BA.PAON_END_NUMBER paon_end_number,
  BA.PAON_END_NUMBER_SUFFIX paon_end_number_suffix,
  BA.PAON_DESCRIPTION paon_description,
  BA.SAON_DESCRIPTION saon_description,
  BA.SAON_START_NUMBER saon_start_number,
  BA.SAON_START_NUMBER_SUFFIX saon_start_number_suffix,
  BA.SAON_END_NUMBER saon_end_number,
  BA.SAON_END_NUMBER_SUFFIX saon_end_number_suffix,
  BA.STREET,
  BA.LOCALITY,
  BA.TOWN,
  COUNTY_LOOKUP.SHORT_DESCRIPTION county,
  BA.POSTCODE,
  BA.UK_INTERNAL_CODE uk_internal_code,
  BA.COUNTRY_CODE country_code
FROM TARGET_SUB_LOCATION SL
LEFT JOIN AHBRP.FEATURE F
  ON F.FEATURE_PK = SL.FEATURE_PK
LEFT JOIN CURRENT_FEATURE_STATE FS
  ON FS.FEATURE_PK = SL.FEATURE_PK
 AND FS.STATE_RANK = 1
LEFT JOIN CURRENT_FEATURE_POINT FP
  ON FP.FEATURE_PK = SL.FEATURE_PK
 AND FP.POINT_RANK = 1
LEFT JOIN CURRENT_FEATURE_ADDRESS FA
  ON FA.FEATURE_PK = SL.FEATURE_PK
 AND FA.ADDRESS_RANK = 1
LEFT JOIN AHBRP.BS7666_ADDRESS BA
  ON BA.ADDRESS_PK = FA.ADDRESS_PK
LEFT JOIN COUNTY_LOOKUP
  ON COUNTY_LOOKUP.CODE = BA.ADMINISTRATIVE_AREA
-- INACTIVE features are not returned: leave out a sub-location whose current
-- states are all INACTIVE. One with no current state at all keeps a null
-- status, as before.
WHERE FS.FEATURE_PK IS NOT NULL
   OR NOT EXISTS (
     SELECT 1
     FROM AHBRP.FEATURE_STATE ANY_FS
     WHERE ANY_FS.FEATURE_PK = SL.FEATURE_PK
       AND ANY_FS.FEATURE_STATE_TO_DTTM IS NULL
   )
ORDER BY SL.PREMISES_FEATURE_PK, SL.FEATURE_PK
"
`;
